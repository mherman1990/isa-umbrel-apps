      "_note": "Markets tab — USDA NASS soybean supply/price. Free key NASS_API_KEY."
    },
    "eia": {
      "enabled": true,
      "maxItemsPerRun": 10,
      "_note": "Markets tab — EIA biofuel feedstock (soy oil → biodiesel/renewable diesel) + diesel. Free key EIA_API_KEY."
    },
    "cftc": {
      "enabled": true,
      "maxItemsPerRun": 5,
      "_note": "Markets tab — CFTC managed-money fund positioning (CBOT soybeans). No key."
    },
    "open_meteo": {
      "enabled": true,
      "maxItemsPerRun": 5,
      "_note": "Markets tab — Open-Meteo S. American soybean-region weather stress. No key."
    },
    "usda_ams": {
      "enabled": true,
      "maxItemsPerRun": 5,
      "_note": "Markets — USDA AMS MARS API, TWO reports on one key (USDA_AMS_API_KEY). 2850 Iowa Daily Cash Grain Bids → daily Iowa cash price + basis + a separate PROCESSOR basis (crush plants' own bid), ~1,478 days back to 2020-08. 3511 National Grain & Oilseed Processor Feedstuff → weekly Iowa cash meal / oil / hulls (loose + pellets), ~223 weeks back to 2022-02. Derived: ams:ia:cash-crush-margin (Denny workbook yields on observed AMS cash). Charts: soy_basis, soy_crush_margin, and the daily cash line on soy_price."
    },
    "agtransport": {
      "enabled": true,
      "maxItemsPerRun": 10,
      "_note": "Markets tab — USDA Ag Transport (Socrata, no key): soybean export inspections + net export sales (FAS stand-in) + Mississippi barge freight."
    },
    "drought_monitor": {
      "enabled": true,
      "maxItemsPerRun": 5,
      "_note": "Markets tab — U.S. Drought Monitor (no key): Iowa % area in drought (D1+) and abnormally dry+ (D0+)."
    },
    "ibge_brazil": {
      "enabled": true,
      "maxItemsPerRun": 3,
      "_note": "Markets — IBGE SIDRA (no key): Brazil soybean production + area (LSPA 1618 current-crop + PAM 1612 long trend)."
    },
    "fred": {
      "enabled": true,
      "maxItemsPerRun": 3,
      "_note": "Markets — FRED macro (free FRED_API_KEY): U.S. broad dollar index + 10-year Treasury yield."
    },
    "wasde": {
      "enabled": true,
      "maxItemsPerRun": 3,
      "_note": "Markets — USDA WASDE balance sheet (no key). U.S. soybean ending stocks + stocks-to-use (soy_balance / soy_balance_stu charts) + a level-based stocks-to-use signal; world ending stocks (MMT) ride in the item summary."
    },
    "barchart": {
      "enabled": false,
      "maxItemsPerRun": 5,
      "_note": "Markets — Barchart OnDemand (needs BARCHART_API_KEY). SCAFFOLD: no-ops without a key. Enable + confirm response fields once the key lands."
    },
    "vegscape": {
      "enabled": true,
      "maxItemsPerRun": 5,
      "_note": "Markets — USDA/NASS VegScape satellite crop VCI (no key): weekly 0–100 vegetation condition for Iowa + IL/MN/IN/NE cropland. Leading read on crop vigor, ahead of the NASS G/E rating (veg_condition chart + signal)."
    },
    "cropcasma": {
      "enabled": true,
      "maxItemsPerRun": 5,
      "_note": "Markets — Crop-CASMA / NASA SMAP soil moisture (no key, open WPS): weekly root-zone (+ Iowa surface) volumetric moisture for Iowa + IL/MN/IN/NE. Cause-side crop-stress read that leads the VCI + condition reports (soil_moisture chart + signal). First market-refresh backfills ~30 weeks (tiny CSVs)."
    },
    "cbot_futures": {
      "enabled": true,
      "maxItemsPerRun": 3,
      "hullsUsdPerTon": 140,
      "_note": "Markets — DAILY CBOT settles (no key, Yahoo chart endpoint): beans/meal/oil/corn front-month + derived board crush margin + daily soy:corn ratio. ~1,256 daily points (5y) per leg. This is the first sub-monthly price series in the tool and the prerequisite for scoring any signal against a subsequent price move. KEYLESS INTERIM ahead of Barchart — series are namespaced cbot:* so both can coexist. hullsUsdPerTon is a static assumption for the board margin's hulls leg (no futures market for hulls); the Iowa CASH margin in usda_ams uses the real AMS hulls quote instead."
    }
  },
